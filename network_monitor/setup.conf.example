# Copy these values to /opt/network_monitor2/setup.conf through setup_v2.sh.
# Never commit a setup.conf containing real credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=network_monitor_v2
DB_USER=network_monitor
DB_PASS=change_me
IPERF_TABLE=iperf_results
PING_TABLE=ping_results
INTERRUPTIONS_TABLE=interruptions

# Optional: configure a read-only remote DB account to add remote iperf
# columns to Excel exports. Leave REMOTE_DB_HOST empty to disable it.
REMOTE_DB_HOST=
REMOTE_DB_PORT=3306
REMOTE_DB_NAME=
REMOTE_DB_USER=
REMOTE_DB_PASS=
